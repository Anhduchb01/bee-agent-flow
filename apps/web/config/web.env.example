# /etc/bee/web.env — cấu hình của dashboard. chown root:bee-web, chmod 640.
#
# KHÔNG chứa GH_TOKEN, và không bao giờ được chứa. App nói chuyện với GitHub
# bằng token của NGƯỜI ĐANG ĐĂNG NHẬP: dấu vết kiểm toán chỉ đúng khi nó mang
# tên người thật, và chữ ký duyệt của PM chỉ có nghĩa khi GitHub tin chính PM
# đã ký. Đó cũng là lý do app không có nút merge.

# --- Nguồn dữ liệu ------------------------------------------------------------
# `disk` đọc /srv/bee thật. Đổi về `fixture` để demo mà không cần reconciler.
BEE_SOURCE=disk
BEE_SRV=/srv/bee

# `live` cộng dồn state/recent.jsonl và đọc state/claude-rate-limit.json.
# Cần BEE_SOURCE=disk — nó đi qua lib/bee, không tự mở file nào.
CLAUDE_SOURCE=live

# `live` đọc GitHub bằng token người đăng nhập. CHỈ bật được sau khi đã có
# GitHub OAuth app thật (ba biến AUTH_* bên dưới). Bật sớm thì mọi màn hình đổ
# với "No GitHub token for the signed-in user".
GITHUB_SOURCE=fixture

# --- Đăng nhập ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app: Settings → Developer settings → OAuth Apps.
#   Homepage URL:       https://bee.tenmien-cua-ban
#   Callback URL:       https://bee.tenmien-cua-ban/api/auth/callback/github
# Scope `repo` là bắt buộc để đọc repo private và ghi issue/comment/review.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# URL công khai của app. Quyết định tên cookie session (có tiền tố __Secure-
# khi https), nên sai biến này là đăng nhập xong vẫn bị đá về trang đăng nhập.
#
# Mặc định là loopback CÓ CHỦ Ý: một placeholder kiểu `https://bee.ten-mien`
# không phải chỗ trống, nó là một lệnh chuyển hướng thật tới một tên miền không
# tồn tại — cài xong mở trình duyệt là thấy app "hỏng", và nguyên nhân nằm ở
# một file không ai nghĩ tới. Đổi hai dòng này khi đưa ra ngoài.
#
# ⚠ `localhost` và `127.0.0.1` là HAI HOST KHÁC NHAU với trình duyệt, và với
# GitHub. Ba chỗ dưới đây phải dùng ĐÚNG MỘT trong hai, giống hệt nhau:
#
#     AUTH_URL ở file này
#     Authorization callback URL của OAuth app trên GitHub
#     địa chỉ bạn gõ vào thanh địa chỉ
#
# Lệch một chỗ thì hỏng theo hai kiểu, và không kiểu nào nói ra nguyên nhân:
#
#   Gõ `localhost` khi AUTH_URL là `127.0.0.1` → Auth.js chuyển hướng về host
#   đúng, nhưng Next rút gọn Location thành đường dẫn tương đối nên trình duyệt
#   ở nguyên localhost và LẶP VÔ HẠN. Chrome báo ERR_TOO_MANY_REDIRECTS.
#
#   Bắt đầu đăng nhập ở host này rồi quay về host kia → cookie PKCE không được
#   gửi kèm (cookie gắn theo host), Auth.js báo `InvalidCheck: pkceCodeVerifier
#   value could not be parsed` và đá ra `/api/auth/error?error=Configuration`.
#   Câu đó nói "có vấn đề với cấu hình máy chủ" trong khi cấu hình hoàn toàn
#   đúng và thứ sai là chữ trong thanh địa chỉ.
AUTH_URL=http://127.0.0.1:3187
APP_URL=http://127.0.0.1:3187

# Ai được vào. RỖNG NGHĨA LÀ KHÔNG AI, không phải "ai cũng được" — mặc định mở
# là kiểu lỗi cấu hình chỉ lộ ra khi đã có người lạ ở trong.
ALLOWED_LOGINS=
# Ai là Techlead. Không có tên ở đây thì mặc định là PM.
BEE_TL_LOGINS=

# --- Trạng thái của app -------------------------------------------------------
# Danh sách dự án và trạng thái "đã báo Slack". KHÔNG nằm dưới /srv/bee — unit
# systemd gắn chỗ đó ở chế độ chỉ-đọc, và đó là chủ ý.
BEE_WEB_STATE_DIR=/var/lib/bee-web
NOTIFY_STATE_DIR=/var/lib/bee-web/notify

# --- Bằng chứng ---------------------------------------------------------------
# Phải KHỚP với BEE_WEB_URL trong /etc/bee/bee.env, nếu không thì liên kết trong
# khối bằng chứng của PR trỏ đi đâu đó khác với chỗ app thật sự chạy.

# --- Slack (tuỳ chọn) ---------------------------------------------------------
SLACK_WEBHOOK_URL=
# Bí mật dùng chung cho /api/notify — nó do systemd timer gọi, không phải người
# dùng. Chạy live mà thiếu biến này thì route tự tắt.
NOTIFY_SECRET=
