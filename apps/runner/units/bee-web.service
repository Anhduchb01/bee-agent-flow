# The web as a user unit: survives logout (linger) and reboot, and gives
# Cloudflare Access a stable local origin. All runtime config lives in
# @BEE_ROOT@/web.env — one file to edit, `systemctl --user restart bee-web`
# to apply. Rendered by install.sh only when a standalone build exists.
[Unit]
Description=bee web — session dashboard
After=network-online.target

[Service]
# systemd user services get a bare PATH (no ~/.nvm, no ~/.local/bin) —
# render the real one here or `claude`/`node` resolve to whatever apt left
# in /usr/local/bin, if anything at all.
Environment=PATH=@BINPATH@
Environment=BEE_ROOT=@BEE_ROOT@
EnvironmentFile=-@BEE_ROOT@/web.env
ExecStart=@NODE@ @WEBSERVER@
Restart=on-failure
RestartSec=3
# Một lệnh `stop` CÓ CHỦ ĐÍCH không được đọc thành hỏng hóc. Next đóng bằng
# SIGTERM rồi thoát 143, nên nếu không có dòng này thì mỗi lần dừng web đều
# để lại unit ở trạng thái `failed` và nằm luôn trong `systemctl --failed`.
# Cùng một cái giá với `doctor.sh --exit-zero`: cảnh báo nào cũng có sẵn thì
# chẳng cảnh báo nào được đọc nữa. Chết vì SIGKILL (137) hay lỗi thật thì
# VẪN đỏ, và Restart=on-failure vẫn nhặt lên.
SuccessExitStatus=143 SIGTERM

[Install]
WantedBy=default.target
