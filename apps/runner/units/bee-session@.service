# Một phiên agent = một instance của template này. Instance name = UUID phiên.
# Khoá trùng, liệt kê, tách log — cả ba systemd cho miễn phí.
[Unit]
Description=bee session %i

[Service]
# systemd user services get a bare PATH (no ~/.nvm, no ~/.local/bin) —
# render the real one here or `claude`/`node` resolve to whatever apt left
# in /usr/local/bin, if anything at all.
Environment=PATH=@BINPATH@
Environment=BEE_ROOT=@BEE_ROOT@
Type=simple
ExecStart=@PREFIX@/bin/session-run.sh %i
# Trần cứng cho một phiên — phanh cuối khi mọi thứ khác quên dừng.
RuntimeMaxSec=6h
# systemctl stop = nút Dừng: TERM cho session-run.sh, trap đóng sổ "stopped";
# 20 giây sau mới KILL cả nhóm nếu còn sót.
KillMode=mixed
TimeoutStopSec=20
