# Một phiên agent = một instance của template này. Instance name = UUID phiên.
# Khoá trùng, liệt kê, tách log — cả ba systemd cho miễn phí.
[Unit]
Description=bee session %i

[Service]
# systemd user services get a bare PATH (no ~/.nvm, no ~/.local/bin) —
# render the real one here or `claude`/`node` resolve to whatever apt left
# in /usr/local/bin, if anything at all.
Environment=PATH=@BINPATH@
Environment=BEE_ROOT=@BEE_ROOT@
Type=simple
ExecStart=@PREFIX@/bin/session-run.sh %i
# Trần cứng cho một phiên — phanh cuối khi mọi thứ khác quên dừng.
RuntimeMaxSec=6h

# Trần TÀI NGUYÊN (T17). systemd thi hành được vì `user@` của bee đã được
# delegate `cpu memory pids` — kiểm bằng:
#   cat /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers
#
# MemorySwapMax=0 KHÔNG phải chi tiết phụ: đo thật 27/08, chỉ đặt MemoryMax
# thì tiến trình vượt trần được đẩy sang swap và sống nhăn — 400MB cấp trọn
# dưới một cái trần 40M. Với swap bị chặn, cùng bài đó bị OOM-kill (137).
# Một cái trần trông như đã đặt mà không chặn gì thì tệ hơn không có trần.
MemoryMax=@SESSION_MEM_MAX@
MemorySwapMax=0
# Fork bomb: nhiều tiến trình rẻ hơn nhiều RAM, nên trần này phải riêng.
TasksMax=4096
# KHÔNG phải CPUQuota. Một phiên chạy một mình được dùng cả máy — đó là điều
# mong muốn. Cái phải tránh là phiên bóp chết web và OS lúc tranh chấp, và
# trọng số làm đúng việc đó: dưới tranh chấp, phiên nhường.
CPUWeight=50
# systemctl stop = nút Dừng: TERM cho session-run.sh, trap đóng sổ "stopped";
# 20 giây sau mới KILL cả nhóm nếu còn sót.
KillMode=mixed
TimeoutStopSec=20
