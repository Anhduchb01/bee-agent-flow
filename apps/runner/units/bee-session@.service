# Một phiên agent = một instance của template này. Instance name = UUID phiên.
# Khoá trùng, liệt kê, tách log — cả ba systemd cho miễn phí.
[Unit]
Description=bee session %i

[Service]
# systemd user services get a bare PATH (no ~/.nvm, no ~/.local/bin) —
# render the real one here or `claude`/`node` resolve to whatever apt left
# in /usr/local/bin, if anything at all.
Environment=PATH=@BINPATH@
Environment=BEE_ROOT=@BEE_ROOT@
Type=simple
ExecStart=@PREFIX@/bin/session-run.sh %i
# BACKSTOP ONLY — not the session ceiling anyone should hit. RuntimeMaxSec
# counts WALL time since the unit went active and cannot be told about
# activity, so at the old 6h it killed sessions for WAITING: a question asked
# at midnight was dead by morning, having burned its 6h sitting idle at the
# prompt. The real ceiling is SESSION_IDLE_H in the reaper — 24h since the last
# thing either side did. This number exists only for the case where the reaper
# itself is dead, and is set far above any session a human is still in.
RuntimeMaxSec=7d

# RESOURCE caps (T17). systemd can enforce these because bee's `user@` is
# already delegated `cpu memory pids` — check with:
#   cat /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/cgroup.controllers
#
# MemorySwapMax=0 is not a detail: measured 27/08, MemoryMax alone lets a
# process over the cap be pushed to SWAP, where it survives — 400MB handed out
# under a 40M cap. With swap blocked, the same test is OOM-killed (137). A cap
# that looks set and stops nothing is worse than no cap, because it is believed.
MemoryMax=@SESSION_MEM_MAX@
MemorySwapMax=0
# A fork bomb is far cheaper than RAM, so it needs its own ceiling.
TasksMax=4096
# NOT CPUQuota. A session running alone SHOULD get the whole machine — that is
# the point. What must not happen is it starving the web and the OS under
# contention, and a weight does exactly that job: under contention it yields.
CPUWeight=50
# systemctl stop = nút Dừng: TERM cho session-run.sh, trap đóng sổ "stopped";
# 20 giây sau mới KILL cả nhóm nếu còn sót.
KillMode=mixed
TimeoutStopSec=20
