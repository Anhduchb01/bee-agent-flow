# Oneshot: `systemctl --user start bee-gc` chạy xong mới trả về, nên nút "Dọn
# ngay" trên web đọc được gc.json tươi ngay sau đó — cùng kiểu với bee-doctor.
[Unit]
Description=bee gc — thu hồi worktree của phiên đã kết thúc

[Service]
# systemd user services get a bare PATH (no ~/.nvm, no ~/.local/bin) —
# render the real one here or `claude`/`node` resolve to whatever apt left
# in /usr/local/bin, if anything at all.
Environment=PATH=@BINPATH@
Type=oneshot
Environment=BEE_ROOT=@BEE_ROOT@
ExecStart=@PREFIX@/bin/gc.sh
