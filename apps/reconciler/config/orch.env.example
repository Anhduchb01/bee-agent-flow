# /etc/bee/orch.env — BÍ MẬT. chown root:root, chmod 600.
#
# File này chỉ được nạp vào tiến trình của bee-orch qua EnvironmentFile.
# bee-agent không đọc được, và cũng không đọc được /proc/<orch>/environ
# vì khác UID.
#
# GH_TOKEN dùng fine-grained PAT, cấp đúng ba quyền:
#     Contents: write · Pull requests: write · Issues: write
#
# CỐ Ý KHÔNG CẤP quyền "Workflows". GitHub sẽ từ chối mọi push có sửa file trong
# .github/workflows/, nghĩa là agent không thể tự nới guardrail của chính nó —
# kể cả khi nó sửa được file trên đĩa, push sẽ fail. Đây là thứ gần nhất với
# protected branch mà gói Free cho phép.
GH_TOKEN=github_pat_xxxxxxxxxxxx

# MinIO cho bằng chứng (M3) và log đầy đủ.
# Dùng BUCKET RIÊNG: `mc anonymous set download` mở public cả bucket, đừng bao
# giờ trỏ vào bucket asset của ứng dụng.
MINIO_ENDPOINT=https://minio.yourdomain.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
EVIDENCE_BUCKET=pr-evidence
