# /etc/bee/bee.env — cấu hình toàn cục, đọc được (không chứa bí mật).
# Bí mật nằm ở orch.env, quyền 600, chỉ root đọc.

# --- Slot ---------------------------------------------------------------------
# Toàn cục, không phải mỗi repo. RAM là tài nguyên chung.
# Máy 32GB: 3 / 1 / 2.  Máy 16GB: 2 / 1 / 2.
MAX_BUILD_SLOTS=3

# CỐ ĐỊNH LÀ 1. Ba lần chạy Playwright cùng lúc sẽ làm nhau timeout, và bằng
# chứng flaky tệ hơn bằng chứng chậm — nó dạy reviewer mất niềm tin vào đúng thứ
# đáng tin. Đây là chỗ cố ý không song song hoá.
MAX_EVIDENCE_SLOTS=1

# Một repo không được chiếm sạch slot build.
MAX_PER_REPO=2

# --- Giới hạn chạy ------------------------------------------------------------
# Giới hạn THẬT là max-turns. Không có cách chặn cứng theo đô-la: CLI chỉ báo
# chi phí sau khi chạy xong, và trên gói thuê bao thì con số đó cũng mất ý nghĩa
# — theo dõi bằng turn và thời lượng.
MAX_TURNS=80
AGENT_TIMEOUT=30m

# --- Giám sát -----------------------------------------------------------------
HEARTBEAT_STALE_S=600
RECENT_KEEP=20

# --- Tính năng ----------------------------------------------------------------
# Preview env là opt-in ở hai cấp: cờ này bật cả tính năng, rồi từng PR còn phải
# có label preview:on. Mốc M6.
ENABLE_PREVIEW=0
PREVIEW_DOMAIN=yourdomain.com
MAX_PREVIEWS=3
