#!/usr/bin/env bash
#
# be 🐝 — CLI vận hành. Gõ `be` không tham số để xem trạng thái.

set -euo pipefail

LIB="${BEE_PREFIX:-/opt/bee}/lib"
source "$LIB/common.sh"; source "$LIB/config.sh"
source "$LIB/github.sh"; source "$LIB/state.sh"

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
DOC_FAIL=0
ck()   { printf '  %s✓%s %s\n' "$C_GREEN"  "$C_RESET" "$*"; }
cx()   { printf '  %s✗%s %s\n' "$C_RED"    "$C_RESET" "$*"; DOC_FAIL=1; }
cw()   { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
sect() { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }

cmd_doctor() {
  load_global_config

  sect "Công cụ"
  local t
  for t in git jq gh docker node claude python3 ffmpeg; do
    if command -v "$t" >/dev/null 2>&1; then ck "$t"
    elif [[ "$t" == "claude" ]]; then cw "$t — chỉ cần dưới user $AGENT_USER, kiểm ở dưới"
    # ffmpeg chỉ để chuyển webm sang mp4 cho tua được. Thiếu thì bằng chứng vẫn
    # ra, chỉ là ở dạng webm — cảnh báo, không phải lỗi.
    elif [[ "$t" == "ffmpeg" ]]; then cw "$t — chưa có, bằng chứng sẽ giữ nguyên webm"
    else cx "$t — thiếu"; fi
  done

  # Node của BEE-ORCH, không phải node trong PATH của người đang gõ lệnh.
  #
  # nvm, conda, asdf chỉ sống trong shell tương tác của một người. bee-orch và
  # bee-agent chạy qua sudo/systemd nên chúng lấy /usr/bin/node. Vòng lặp phía
  # trên hỏi sai user, và nó trả lời "✓ node" trên một máy mà mọi lần chạy CI
  # đều đổ vì node quá cũ.
  local node_orch node_major
  node_orch=$(sudo -u "$ORCH_USER" -H bash -lc 'node -v' 2>/dev/null || true)
  if [[ -z "$node_orch" ]]; then
    cw "chưa tra được node của $ORCH_USER — chạy: sudo be doctor"
  else
    node_major=${node_orch#v}; node_major=${node_major%%.*}
    if (( node_major >= 20 )); then
      ck "$ORCH_USER dùng node $node_orch"
    else
      cx "$ORCH_USER dùng node $node_orch — quá cũ, Next.js cần >= 20.9
       Bạn có thể đang có bản mới hơn qua nvm, nhưng nvm không tới được $ORCH_USER.
       Sửa: chạy lại installer KHÔNG kèm --no-deps"
    fi
  fi

  sect "User & ranh giới quyền"
  id -u "$ORCH_USER"  >/dev/null 2>&1 && ck "user $ORCH_USER"  || cx "thiếu user $ORCH_USER"
  id -u "$AGENT_USER" >/dev/null 2>&1 && ck "user $AGENT_USER" || cx "thiếu user $AGENT_USER"

  # Thuộc group docker = tương đương root: docker run -v /:/host đọc được mọi thứ.
  # Nếu agent lọt vào đây thì toàn bộ thiết kế hai user sụp trong một dòng lệnh.
  if thuoc_group "$AGENT_USER" docker; then
    cx "NGUY HIỂM: $AGENT_USER thuộc group docker — tương đương quyền root"
  else
    ck "$AGENT_USER KHÔNG thuộc group docker"
  fi
  thuoc_group "$ORCH_USER" docker \
    && ck "$ORCH_USER thuộc group docker" || cw "$ORCH_USER chưa vào group docker — CI sẽ không dựng được service"

  # Kiểm chứ đừng đoán: đây là thứ nếu sai thì không có dấu hiệu nào cả.
  if sudo -u "$AGENT_USER" -H env 2>/dev/null | grep -qiE '(gh_token|github_token|_key=|_secret)'; then
    cx "NGUY HIỂM: môi trường của $AGENT_USER có chứa token/secret"
  else
    ck "$AGENT_USER không thấy token nào trong môi trường"
  fi

  # `sudo -u <agent> -n true` KHÔNG trả lời câu hỏi này. Nó hỏi "NGƯỜI ĐANG GÕ có
  # được hoá thân thành agent không" — mà người đang gõ gần như luôn là một
  # sudoer, nên nó báo NGUY HIỂM trên một máy hoàn toàn lành.
  #
  # Kêu sai ở đúng chỗ quan trọng nhất còn tệ hơn không kêu: lần sau có cảnh báo
  # thật, người ta đã được dạy là bỏ qua.
  #
  # `sudo -l -U <user>` mới đúng — liệt kê những gì CHÍNH user đó được chạy.
  # Nó cần quyền root để tra, nên kiểm group trước: rẻ, luôn chạy được, và bắt
  # được đường lọt phổ biến nhất.
  local sudo_list
  if thuoc_group "$AGENT_USER" sudo || thuoc_group "$AGENT_USER" admin \
     || thuoc_group "$AGENT_USER" wheel; then
    cx "NGUY HIỂM: $AGENT_USER thuộc group sudo/admin/wheel"
  elif sudo_list=$(sudo -n -l -U "$AGENT_USER" 2>/dev/null); then
    # Dòng đặc quyền của sudo luôn có dạng "    (ALL) ALL"; câu từ chối thì
    # không có dấu ngoặc nào. Bắt theo hình dạng chứ không theo câu chữ, để
    # không phụ thuộc ngôn ngữ của hệ thống.
    if grep -qE '^[[:space:]]*\(' <<<"$sudo_list"; then
      cx "NGUY HIỂM: $AGENT_USER có quyền sudo"
    else
      ck "$AGENT_USER không có sudo"
    fi
  else
    cw "$AGENT_USER không thuộc group sudo, nhưng chưa tra được sudoers — chạy: sudo be doctor"
  fi

  if [[ ! -f /etc/sudoers.d/bee ]]; then
    cx "thiếu /etc/sudoers.d/bee"
  elif [[ ! -r /etc/sudoers.d/bee ]]; then
    # File là 440 root:root — đúng như nó phải thế. Không đọc được khi chạy
    # không có root là chuyện bình thường, không phải dấu hiệu hỏng.
    cw "chưa đọc được /etc/sudoers.d/bee (cần root) — chạy: sudo be doctor"
  else
    visudo -cf /etc/sudoers.d/bee >/dev/null 2>&1 \
      && ck "sudoers hợp lệ" || cx "sudoers sai cú pháp"
    # Đếm dòng LUẬT, không đếm chú thích. File này cố ý có 17 dòng giải thích vì
    # sao ranh giới chỉ được có một dòng — đếm cả chúng thì chính lời giải thích
    # lại làm cảnh báo nổ, và cảnh báo đó không bao giờ tắt được.
    local rules; rules=$(grep -cE '^[[:space:]]*[^#[:space:]]' /etc/sudoers.d/bee)
    if (( rules <= 1 )); then
      ck "sudoers hẹp (đúng $rules dòng luật, chỉ agent-exec.sh)"
    else
      cw "sudoers có $rules dòng luật — ranh giới chỉ nên có một, soát lại"
    fi
  fi

  sect "Thư mục"
  local d
  for d in "$BEE_SRV/repos" "$BEE_SRV/work" "$BEE_SRV/state" \
           "$BEE_SRV/public" "$BEE_ETC/repos.d" "$BEE_PREFIX/bin"; do
    [[ -d "$d" ]] && ck "$d" || cx "thiếu $d"
  done
  [[ -f "$BEE_ETC/orch.env" ]] && {
    [[ "$(stat -c %a "$BEE_ETC/orch.env")" == "600" ]] \
      && ck "orch.env quyền 600" || cx "orch.env phải là 600 (đang $(stat -c %a "$BEE_ETC/orch.env"))"
  } || cw "chưa có orch.env — chưa cấu hình GH_TOKEN"

  sect "Đăng nhập"

  # Token dài hạn: cách duy nhất chia được quyền gọi model mà không có hai bên
  # tranh nhau làm mới một token xoay vòng.
  local agent_env="$BEE_ETC/agent.env" tok=""
  if [[ ! -f "$agent_env" ]]; then
    cw "chưa có $agent_env — chạy lại installer"
  else
    [[ "$(stat -c '%U:%G %a' "$agent_env")" == "root:$AGENT_USER 640" ]] \
      && ck "agent.env 640 root:$AGENT_USER" \
      || cx "agent.env phải là 640 root:$AGENT_USER (đang $(stat -c '%U:%G %a' "$agent_env"))"

    # Kiểm CẢ HAI chiều. "agent đọc được" là chức năng; "orch và web KHÔNG đọc
    # được" là ranh giới, và ranh giới thì không có triệu chứng khi nó hỏng.
    if sudo -n -u "$ORCH_USER" test -r "$agent_env" 2>/dev/null \
       || sudo -n -u bee-web test -r "$agent_env" 2>/dev/null; then
      cx "NGUY HIỂM: $ORCH_USER hoặc bee-web đọc được agent.env — đó là quyền gọi model"
    else
      ck "chỉ $AGENT_USER đọc được agent.env"
    fi

    tok=$(sudo -n grep -oP '(?<=^CLAUDE_CODE_OAUTH_TOKEN=).*' "$agent_env" 2>/dev/null | tr -d '[:space:]' || true)
    if [[ -n "$tok" ]]; then
      ck "có token dài hạn (${#tok} ký tự)"
    elif [[ -f "/home/$AGENT_USER/.claude/.credentials.json" ]]; then
      # Đây là bản copy từ --claude-from. Nó CHẠY, cho tới lúc user nguồn làm
      # mới phiên của họ — và lúc đó nó hỏng giữa một lần chạy agent.
      cw "chưa có token dài hạn, đang dùng bản copy .credentials.json"
      cw "   bản copy sẽ bị thu hồi khi user nguồn làm mới phiên. Sửa: be token"
    else
      cw "chưa có token dài hạn và cũng chưa có credential — be token"
    fi
  fi

  sudo -u "$AGENT_USER" -H bash -lc 'command -v claude >/dev/null && claude -p "ok" --max-turns 1' \
       >/dev/null 2>&1 \
    && ck "claude đã đăng nhập dưới $AGENT_USER" \
    || cx "claude chưa sẵn sàng dưới $AGENT_USER — chạy: sudo -u $AGENT_USER -H claude
       Hay gặp nhất: bản cài dùng --claude-from, và token đã bị THU HỒI khi
       user nguồn làm mới phiên của họ. Đăng nhập riêng dưới $AGENT_USER thì
       không dính nữa — mỗi lần đăng nhập là một token riêng."
  sudo -u "$ORCH_USER" -H gh auth status >/dev/null 2>&1 \
    && ck "gh đã đăng nhập dưới $ORCH_USER" \
    || cx "gh chưa đăng nhập — chạy: sudo -u $ORCH_USER -H gh auth login"

  sect "systemd"
  systemctl list-unit-files bee-reconcile.timer >/dev/null 2>&1 \
    && ck "unit đã cài" || cx "chưa cài systemd unit"
  systemctl is-active --quiet bee-reconcile.timer \
    && ck "timer đang chạy" || cw "timer chưa chạy — be resume"
  systemctl list-unit-files 'bee-task@.service' >/dev/null 2>&1 \
    && ck "template unit bee-task@" || cx "thiếu template unit"

  sect "Trạng thái"
  [[ -f "$BEE_ETC/PAUSE" ]] && cw "ĐANG TẠM DỪNG (/etc/bee/PAUSE)" || ck "không bị tạm dừng"
  # "Chưa từng có tick nào" khác hẳn "có rồi mà cũ", dù `heartbeat_age_s` trả về
  # cùng một con số to (999999 khi thiếu file). Máy vừa cài xong rơi vào vế đầu,
  # và báo ✗ "có thể đã chết im lặng" ở một máy chưa từng chạy là nói sai —
  # nó biến một bản cài đúng thành "CÓ LỖI CẦN SỬA".
  local age hb="$BEE_SRV/state/heartbeat"; age=$(heartbeat_age_s)
  if [[ ! -f "$hb" ]]; then
    cw "chưa có heartbeat — reconciler chưa chạy tick nào (bình thường khi vừa cài)"
  elif (( age > HEARTBEAT_STALE_S )); then
    cx "heartbeat cũ $(human_dur "$age") — reconciler có thể đã chết im lặng"
  else
    ck "heartbeat $(human_dur "$age") trước"
  fi
  printf '  %s·%s slot build %s/%s · evidence %s/%s\n' "$C_DIM" "$C_RESET" \
         "$(running_in_pool build)" "$MAX_BUILD_SLOTS" \
         "$(running_in_pool evidence)" "$MAX_EVIDENCE_SLOTS"

  sect "Repo"
  local n=0 slug
  # `( … ) || DOC_FAIL=1` chứ không chỉ `( … )`.
  #
  # Subshell cần thiết để biến REPO_* của repo này không rò sang repo sau. Nhưng
  # `cx` đặt `DOC_FAIL=1` BÊN TRONG subshell, và biến đó chết cùng subshell —
  # nên doctor in ra dấu ✗ đỏ chót rồi kết luận "Tất cả đều ổn" ở dòng cuối.
  #
  # Đúng cái công cụ mà việc duy nhất của nó là trả lời "có ổn không".
  for slug in $(enabled_repos); do
    n=$((n+1))
    ( DOC_FAIL=0
      load_repo_config "$slug"
      if [[ ! -d "$REPO_GIT" ]]; then
        cx "$slug: thiếu bare clone $REPO_GIT"
      elif ! git --git-dir="$REPO_GIT" rev-parse -q --verify origin/HEAD >/dev/null 2>&1; then
        # Hỏng im lặng nhất trong cả hệ thống: mọi thứ vẫn "chạy", chỉ là không
        # có việc nào khớp, không worktree nào tạo được, và .agent/PAUSE không
        # bao giờ được nhìn thấy. Bare clone cũ (trước bản vá) sẽ dính lỗi này.
        cx "$slug: origin/HEAD không phân giải được — sửa:
       sudo -u $ORCH_USER git --git-dir=$REPO_GIT config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
       sudo -u $ORCH_USER git --git-dir=$REPO_GIT fetch --prune origin
       sudo -u $ORCH_USER git --git-dir=$REPO_GIT remote set-head origin --auto"
      elif [[ -z "${GH_TOKEN:-}" ]]; then
        cw "$slug: chưa nạp GH_TOKEN nên không kiểm được quyền — chạy: sudo be doctor"
      elif ! gh issue list --repo "$REPO_FULL" --limit 1 >/dev/null 2>&1; then
        # Đường hỏng IM LẶNG nhất còn lại. `gh_issues` kết thúc bằng
        # `|| echo '[]'` và `scan_all` gọi `rule_scan … 2>/dev/null`, nên token
        # thiếu quyền trên repo này cho ra đúng cùng một kết quả với "không có
        # việc nào": hàng đợi trống, không lỗi, không log. Bạn sẽ ngồi đợi một
        # tick không bao giờ tới.
        #
        # Fine-grained PAT chỉ áp dụng cho những repo được CHỌN ĐÍCH DANH lúc
        # tạo. Thêm repo vào bee sau khi tạo token là dính đúng chỗ này.
        cx "$slug: token không đọc được issue của $REPO_FULL
       Fine-grained PAT phải chọn đích danh repo này, và cấp Issues + Pull requests + Contents = write.
       Kiểm tay: sudo bash -c 'set -a; . /etc/bee/orch.env; cd /tmp; gh issue list --repo $REPO_FULL --limit 1'"
      else
        ck "$slug → $REPO_FULL ($(git --git-dir="$REPO_GIT" rev-parse --short origin/HEAD)) · token đọc được issue"
      fi
      exit "$DOC_FAIL" ) || DOC_FAIL=1
  done
  (( n )) || cw "chưa có repo nào — be repo add org/name"

  sect "Máy"
  systemctl is-enabled sleep.target >/dev/null 2>&1 \
    && cw "sleep.target chưa bị mask — máy có thể ngủ và treo job" \
    || ck "sleep/hibernate đã bị mask"
  local home; home=$(eval echo "~${SUDO_USER:-$USER}")
  if [[ -d "$home" && "$(stat -c %a "$home")" != "700" ]]; then
    cw "$home quyền $(stat -c %a "$home") — agent có thể đọc được. chmod 700 $home"
  else
    ck "thư mục home đã khoá"
  fi

  printf '\n'
  (( DOC_FAIL )) && { printf '%sCÓ LỖI CẦN SỬA%s\n' "$C_RED" "$C_RESET"; return 1; }
  printf '%sTất cả đều ổn%s\n' "$C_GREEN" "$C_RESET"
}

# ---------------------------------------------------------------------------
cmd_status() {
  local f="$BEE_SRV/public/status.json"
  [[ -f "$f" ]] || die "chưa có status.json — reconciler chưa chạy lần nào"
  jq -r '
    "heartbeat: \(.heartbeat)   chế độ: \(.mode)",
    "slot: build \(.slots.build.used)/\(.slots.build.max) · evidence \(.slots.evidence.used)/\(.slots.evidence.max)",
    "",
    "ĐANG CHẠY",
    (if (.running|length)==0 then "  (trống)" else
      (.running[] | "  \(.id)  \(.rule)  \(.elapsed_s)s") end),
    "",
    (.repos[] |
      "REPO \(.slug)\(if .paused then "  [TẠM DỪNG]" else "" end)  · \(.running) chạy",
      (if (.queue|length)==0 then "  hàng đợi: (trống)" else
        (.queue[] | "  ⏳ #\(.number) \(.title) — \(.wait_reason)") end),
      (.recent[]? | "  ✓ #\(.number) \(.rule) \(.result) \(.duration_s)s")
    )' "$f"
}

cmd_dry_run() {
  # `orch.env` là 600 root:root, nên chạy `be dry` không có sudo thì GH_TOKEN
  # KHÔNG được nạp. Mọi hàm bọc `gh` đều kết thúc bằng `|| echo '[]'`, nên mọi
  # lời gọi API thất bại lặng lẽ thành "không có gì", và dry-run bình thản in ra
  # "không có gì để làm" — một câu trả lời SAI trông y hệt câu trả lời đúng.
  #
  # Đây là lệnh cả mốc M0 dựa vào để tin cái vòng lặp, nên nó phải nói ra khi nó
  # đang mù.
  if [[ ! -r "$BEE_ETC/orch.env" ]]; then
    warn "không đọc được $BEE_ETC/orch.env — GH_TOKEN chưa nạp"
    warn "kết quả dưới đây KHÔNG đáng tin. Chạy lại: sudo be dry-run"
  fi
  BEE_DRY_RUN=1 "$BEE_PREFIX/bin/reconcile.sh" --dry-run
}

cmd_pause()  { sudo touch "$BEE_ETC/PAUSE"; warn "đã tạm dừng — task đang chạy vẫn chạy nốt"; }
cmd_resume() { sudo rm -f "$BEE_ETC/PAUSE"; sudo systemctl start bee-reconcile.timer; info "đã tiếp tục"; }

cmd_logs() {
  local id="${1:?cần <slug>-<số>}"
  journalctl -u "bee-task@$(systemd-escape "$id").service" -n 200 -f --no-pager
}

# ---------------------------------------------------------------------------
cmd_repo() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    add)     repo_add "${1:?cần org/name}" ;;
    list)    repo_list ;;
    enable)  repo_toggle "${1:?cần slug}" 1 ;;
    disable) repo_toggle "${1:?cần slug}" 0 ;;
    remove)  repo_remove "${1:?cần slug}" ;;
    *) die "be repo <add|list|enable|disable|remove>" ;;
  esac
}

repo_add() {
  local full="$1" slug; slug=$(slugify "$full")
  local envf="$BEE_ETC/repos.d/$slug.env" git="$BEE_SRV/repos/$slug.git"

  [[ -f "$envf" ]] && die "repo đã có: $slug"

  # Chạy từ thư mục mà bee-orch ĐỌC ĐƯỢC.
  #
  # `git` từ chối chạy khi không stat nổi thư mục hiện hành, và bạn gần như chắc
  # chắn gõ `be ra` từ trong home của mình — chỗ bee-orch không vào được. Lỗi báo
  # ra khi đó là `failed to stat '/home/ban/...'`, đọc như lỗi phân quyền của
  # repo đích chứ không phải của cwd, nên rất dễ đi tìm sai chỗ.
  cd /srv/bee

  info "clone bare $full → $git"
  sudo -u "$ORCH_USER" git clone --bare "https://github.com/$full.git" "$git"

  # `git clone --bare` KHÔNG đặt remote.origin.fetch và không tạo
  # refs/remotes/origin/*. Thiếu dòng này thì `origin/HEAD` không phân giải được,
  # và cả hệ thống hỏng im lặng: worktree không tạo được, compose file không đọc
  # được, rule 09 không chạy, và `.agent/PAUSE` — kill switch phía GitHub —
  # không bao giờ được nhìn thấy. `remote set-head --auto` cũng fail nếu chưa có
  # ref remote-tracking, nên thứ tự ba lệnh dưới đây là bắt buộc.
  sudo -u "$ORCH_USER" git --git-dir="$git" config \
       remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  sudo -u "$ORCH_USER" git --git-dir="$git" fetch --prune --quiet origin
  sudo -u "$ORCH_USER" git --git-dir="$git" remote set-head origin --auto

  sudo tee "$envf" >/dev/null <<EOF
# $full
REPO=$full
ENABLED=1

# Dùng cho commit status bee/approvals — cách nhau bằng dấu cách.
REVIEWERS_PM=""
REVIEWERS_TL=""

# Trần PR agent mở cùng lúc. Đây là giới hạn ở KHẢ NĂNG REVIEW CỦA NGƯỜI,
# không phải ở phần cứng — tăng slot không giải quyết được nghẽn ở đây.
REPO_MAX_WIP=3
EOF
  sudo chmod 644 "$envf"

  info "đồng bộ label"
  repo_sync_labels "$full"

  printf '\n%sĐã thêm %s%s\n' "$C_GREEN" "$slug" "$C_RESET"
  printf 'Sửa %s để điền REVIEWERS_PM / REVIEWERS_TL.\n' "$envf"
  # Rule 03 bắt buộc file này. Thiếu nó thì mọi PR đều đỏ, và cho tới khi có
  # người đọc journal thì lý do trông như lỗi trong code chứ không phải thiếu file.
  printf 'Repo phải có %sscripts/ci.sh%s (chạy được) — bee không đoán cách chạy test.\n' \
         "$C_BOLD" "$C_RESET"
}

repo_sync_labels() {
  local repo="$1" spec
  while IFS='|' read -r name color desc; do
    [[ -z "$name" ]] && continue
    sudo -u "$ORCH_USER" gh label create "$name" --repo "$repo" \
         --color "$color" --description "$desc" --force >/dev/null 2>&1 || true
  done <<'EOF'
agent:eligible|0E8A16|Agent được phép nhận task này (opt-in, người gắn)
agent:build|1D76DB|Kích hoạt agent build
agent:running|FBCA04|Agent đang xử lý
agent:built|C5DEF5|PR do agent tạo — dùng để đếm WIP
needs-human|B60205|Cần người can thiệp, agent đã dừng
priority:high|D93F0B|Ưu tiên — chen lên đầu hàng đợi
preview:on|5319E7|Dựng preview environment cho PR này
status:draft|E4E669|PM đang viết — agent chưa nhìn tới
status:ready-for-spec|BFD4F2|Chờ agent chấm độ rõ của spec
status:spec-review|BFD4F2|Chờ người duyệt spec
EOF
}

repo_list() {
  local slug f
  shopt -s nullglob
  for f in "$BEE_ETC/repos.d"/*.env; do
    slug=$(basename "$f" .env)
    ( load_repo_config "$slug"
      printf '%-16s %-32s %s  %s chạy\n' "$slug" "$REPO_FULL" \
             "$([[ "$REPO_ENABLED" == 1 ]] && echo 'bật ' || echo 'TẮT ')" \
             "$(running_in_repo "$slug")" )
  done
  shopt -u nullglob
}

repo_toggle() {
  local f="$BEE_ETC/repos.d/$1.env"
  [[ -f "$f" ]] || die "không có repo: $1"
  sudo sed -i -E "s/^ENABLED=.*/ENABLED=$2/" "$f"
  info "$1 → ENABLED=$2"
}

repo_remove() {
  local slug="$1"
  running_in_repo "$slug" | grep -qv '^0$' && die "$slug đang có task chạy — đợi xong đã"
  sudo rm -f "$BEE_ETC/repos.d/$slug.env"
  sudo rm -rf "$BEE_SRV/repos/$slug.git"
  warn "đã gỡ $slug (giữ lại state và log)"
}

# ---------------------------------------------------------------------------
# be token <token>  — đặt token dài hạn của Claude cho bee-agent.
#
# Vì sao cần một lệnh riêng thay vì "mở file ra sửa": file là 0640 root:bee-agent,
# nên sửa tay là `sudo $EDITOR` — và một token dán nhầm chỗ trong một file có
# chú thích dài là lỗi im lặng (biến rỗng, agent lùi về .credentials.json, mọi
# thứ trông vẫn bình thường cho tới lần chạy sau).
#
# Nhận token qua STDIN được: `claude setup-token | sudo be token -` để nó không
# nằm lại trong lịch sử shell.
cmd_token() {
  local tok="${1:-}"
  local f="$BEE_ETC/agent.env"

  [[ $EUID -eq 0 ]] || die "cần root: sudo be token <token>"

  if [[ -z "$tok" ]]; then
    cat <<EOF
Đặt token dài hạn cho $AGENT_USER.

  1. Dưới user CỦA BẠN (không phải root, không phải $AGENT_USER):
        claude setup-token

  2. Rồi một trong hai:
        sudo be token <token vừa in ra>
        claude setup-token | sudo be token -      # không lưu vào lịch sử shell

Vì sao không chép ~/.claude/.credentials.json sang: file đó giữ token XOAY
VÒNG. Hai user cùng giữ một bản sao là hai bên tranh nhau làm mới, và bên làm
mới sau thu hồi token của bên kia — kể cả khi bên kia là chính bạn.
EOF
    return 0
  fi

  [[ "$tok" == "-" ]] && { read -r tok; }
  tok="${tok//[[:space:]]/}"
  [[ -n "$tok" ]] || die "token rỗng"
  # Bắt theo hình dạng chứ không theo tiền tố cụ thể: tiền tố có thể đổi, còn
  # "dán nhầm cả câu hướng dẫn vào" thì luôn ngắn hoặc có khoảng trắng.
  (( ${#tok} >= 20 )) || die "token trông quá ngắn (${#tok} ký tự) — dán nhầm?"

  [[ -f "$f" ]] || install -o root -g "$AGENT_USER" -m 640 /dev/null "$f"
  if grep -q "^CLAUDE_CODE_OAUTH_TOKEN=" "$f" 2>/dev/null; then
    sed -i "s|^CLAUDE_CODE_OAUTH_TOKEN=.*|CLAUDE_CODE_OAUTH_TOKEN=$tok|" "$f"
  else
    printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$tok" >> "$f"
  fi
  chown root:"$AGENT_USER" "$f"; chmod 640 "$f"
  ck "đã ghi token vào $f (0640 root:$AGENT_USER)"

  # Bản copy cũ mà còn nằm đó thì không biết lần chạy sau dùng cái nào — và
  # "không biết dùng cái nào" là cách một lỗi trốn được hàng tuần.
  if [[ -f "/home/$AGENT_USER/.claude/.credentials.json" ]]; then
    cw "vẫn còn /home/$AGENT_USER/.claude/.credentials.json từ --claude-from"
    cw "   token trong môi trường được ưu tiên, nhưng nên xoá cho khỏi nhập nhằng:"
    cw "   sudo rm /home/$AGENT_USER/.claude/.credentials.json"
  fi

  systemctl restart bee-spec-chat.service 2>/dev/null || true
  info "thử lại: sudo be doctor"
}

cmd_uninstall() {
  printf 'Sẽ gỡ: systemd unit, sudoers, /opt/bee, user %s và %s.\n' "$ORCH_USER" "$AGENT_USER"
  printf 'GIỮ LẠI: %s (state, log, bare clone).\n' "$BEE_SRV"
  read -r -p "Chắc chưa? gõ 'yes': " a
  [[ "$a" == "yes" ]] || { warn "huỷ"; return 0; }

  sudo systemctl disable --now bee-reconcile.timer bee-heartbeat.timer 2>/dev/null || true
  sudo systemctl stop 'bee-task@*' 2>/dev/null || true
  sudo rm -f /etc/systemd/system/bee-*.{service,timer} /etc/systemd/system/bee.slice
  sudo systemctl daemon-reload
  sudo rm -f /etc/sudoers.d/bee /usr/local/bin/be /usr/local/bin/bee /etc/bash_completion.d/be
  sudo rm -rf "$BEE_PREFIX"
  sudo userdel "$AGENT_USER" 2>/dev/null || true
  sudo userdel "$ORCH_USER"  2>/dev/null || true
  info "đã gỡ. $BEE_SRV vẫn còn nguyên."
}

# Theo dõi liên tục ngay trong terminal. Tiện hơn mở dashboard khi đang ngồi
# trước máy — và nó dùng đúng status.json mà dashboard dùng, nên hai bên không
# bao giờ nói khác nhau.
cmd_watch() {
  local interval="${1:-2}"
  trap 'printf "\n"; exit 0' INT
  while :; do
    printf '\033[H\033[2J'                       # về góc trên, xoá màn
    printf '%s🐝 be%s · %s · Ctrl-C để thoát\n\n' \
           "$C_BOLD" "$C_RESET" "$(date '+%H:%M:%S')"
    cmd_status 2>/dev/null || warn "chưa có status.json"
    sleep "$interval"
  done
}

# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
${C_BOLD}be${C_RESET} 🐝 — điều phối agent      ${C_DIM}(gõ \`bee\` cũng được, cùng một lệnh)${C_RESET}

  ${C_BOLD}be${C_RESET}                       trạng thái — gõ trống là ra ngay
  ${C_BOLD}be -w${C_RESET} [giây]             theo dõi liên tục, mặc định 2s

  ${C_BOLD}be dr${C_RESET}  ${C_DIM}· doctor${C_RESET}         kiểm tra toàn bộ, gồm cả ranh giới bảo mật
  ${C_BOLD}be dry${C_RESET} ${C_DIM}· dry-run${C_RESET}        xem nó ĐỊNH làm gì, không làm gì cả
  ${C_BOLD}be lg${C_RESET} <id> ${C_DIM}· logs${C_RESET}       log một task, ví dụ: be lg myapp-42
  ${C_BOLD}be p${C_RESET} | ${C_BOLD}be r${C_RESET} ${C_DIM}· pause/resume${C_RESET}  kill switch phía máy

  ${C_BOLD}be ra${C_RESET} org/name ${C_DIM}· repo add${C_RESET}
  ${C_BOLD}be repo${C_RESET} list | enable | disable | remove <slug>
  ${C_BOLD}be token${C_RESET} <token> ${C_DIM}· token Claude dài hạn cho bee-agent${C_RESET}
                         sinh bằng `claude setup-token` dưới user của bạn

  ${C_BOLD}be uninstall${C_RESET}             gỡ hệ thống, giữ lại state và log

Kill switch còn một tầng nữa nằm phía repo: tạo file .agent/PAUSE trên nhánh
main qua giao diện web GitHub — không cần SSH, và lưu vết ai dừng lúc nào.
EOF
}

case "${1:-}" in
  ''|st|status)     shift || true
                    [[ "${1:-}" == "-w" || "${1:-}" == "--watch" ]] \
                      && { shift; cmd_watch "$@"; } || cmd_status ;;
  -w|--watch)       shift; cmd_watch "$@" ;;
  dr|doctor)        shift; cmd_doctor "$@" ;;
  dry|dry-run)      shift; cmd_dry_run "$@" ;;
  lg|logs)          shift; cmd_logs "$@" ;;
  ra)               shift; cmd_repo add "$@" ;;
  repo)             shift; cmd_repo "$@" ;;
  p|pause)          shift || true; cmd_pause ;;
  r|resume)         shift || true; cmd_resume ;;
  token)            shift; cmd_token "$@" ;;
  uninstall)        shift; cmd_uninstall ;;
  -h|--help|help)   usage ;;
  *) die "lệnh không biết: $1  (bee --help)" ;;
esac
