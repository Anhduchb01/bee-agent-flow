[Unit]
Description=bee reconciler — mỗi 30 giây

[Timer]
OnBootSec=60s

# Đếm từ lúc lần chạy trước KẾT THÚC, nên hai tick không bao giờ chồng nhau —
# kể cả khi một tick chạy lâu bất thường. Không cần flock, không cần lock file,
# không cần logic chống trùng. Cron thì cần hết những thứ đó.
OnUnitInactiveSec=30s

AccuracySec=1s
Unit=bee-reconcile.service

[Install]
WantedBy=timers.target
