[Unit]
Description=bee reconciler — dispatcher
Documentation=file:///opt/bee/docs/AGENT_RECONCILER.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=bee-orch
Group=bee
EnvironmentFile=/etc/bee/orch.env
EnvironmentFile=-/etc/bee/bee.env
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8
ExecStart=/opt/bee/bin/reconcile.sh

# Bẫy cố ý: dispatcher chỉ được QUYẾT ĐỊNH, không được LÀM. Nếu có việc dài lọt
# vào đây, systemd giết tick và bạn biết ngay — thay vì phát hiện sau hai tuần
# khi hệ thống chậm một cách khó hiểu.
TimeoutStartSec=120

Slice=bee.slice
Nice=5

PrivateTmp=yes
ProtectSystem=full
# ProtectHome PHẢI là no: cấu hình gh nằm ở /home/bee-orch/.config/gh.
# Bật lên là gh mất đăng nhập với lỗi rất khó đoán.
ProtectHome=no
ReadWritePaths=/srv/bee

[Install]
WantedBy=multi-user.target
