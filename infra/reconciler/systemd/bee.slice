# Giữ chỗ tài nguyên để agent không bao giờ bóp nghẹt phiên làm việc của bạn
# trên chính cái máy đó. Xem AGENT_RECONCILER §16.3.
#
# Số liệu dưới đây tính cho máy 32GB. Máy 16GB thì hạ xuống MemoryHigh=10G /
# MemoryMax=12G và giảm MAX_BUILD_SLOTS còn 2.

[Unit]
Description=bee — reconciler và mọi task

[Slice]
# MemoryHigh ép trước, MemoryMax mới giết. Nhờ vậy biểu hiện khi chạm trần là
# agent chậm lại, chứ không phải bị OOM kill giữa chừng và để lại worktree bẩn.
MemoryHigh=20G
MemoryMax=24G

# Phiên tương tác mặc định có CPUWeight=100, nên bạn luôn được ưu tiên CPU.
CPUWeight=50
IOWeight=50
